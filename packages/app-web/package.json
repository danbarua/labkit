{
  "name": "@labkit/app-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/with-ports.sh bun scripts/dev.ts",
    "dev:api": "bash scripts/with-ports.sh bun --watch --no-clear-screen src/server/main.ts",
    "dev:ui": "bash scripts/with-ports.sh bun node_modules/vite/bin/vite.js --host 127.0.0.1",
    "server": "bash scripts/with-ports.sh bun src/server/main.ts",
    "db:up": "bash scripts/compose.sh up -d db",
    "db:down": "bash scripts/compose.sh stop db",
    "db:migrate": "bun scripts/migrate.ts",
    "build": "vite build",
    "test": "bun test --timeout 60000",
    "e2e": "playwright test",
    "ports": "bash scripts/worktree-ports.sh",
    "check:format": "biome format .",
    "check:lint": "biome lint .",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "typecheck": "bunx --bun tsc --noEmit",
    "dev:with-agent": "bash scripts/with-ports.sh bun scripts/dev-with-agent.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@labkit/acp-client": "workspace:*",
    "@labkit/acp-transcripts": "workspace:*",
    "@labkit/core-db": "workspace:*",
    "@labkit/core-domain": "workspace:*",
    "@labkit/design": "workspace:*",
    "@labkit/ui": "workspace:*",
    "@labkit/view-model": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tanstack/react-router": "^1.170.38",
    "effect": "catalog:",
    "effective-acp": "catalog:",
    "labkit-effect": "github:danbarua/labkit-effect#6be9eb3af2102b573c40ccbabd491d06d44efbe3",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@biomejs/biome": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-age": "catalog:",
    "@labkit/acp-fake": "workspace:*",
    "@labkit/acp-scenarios": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "catalog:",
    "vite": "^7.1.5"
  }
}
