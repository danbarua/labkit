{
  "name": "@labkit/app-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/with-ports.sh bun scripts/dev.ts",
    "dev:api": "bash scripts/with-ports.sh bun --watch --no-clear-screen src/server/main.ts",
    "dev:ui": "bash scripts/with-ports.sh bun node_modules/vite/bin/vite.js --host 127.0.0.1",
    "server": "bash scripts/with-ports.sh bun src/server/main.ts",
    "ingest": "bash scripts/with-ports.sh bun scripts/ingest-overlap-bench.ts",
    "db:up": "bash scripts/compose.sh up -d db",
    "db:down": "bash scripts/compose.sh stop db",
    "build": "vite build",
    "test": "bun test --timeout 60000",
    "e2e": "playwright test",
    "ports": "bash scripts/worktree-ports.sh",
    "check:format": "biome format .",
    "check:lint": "biome lint .",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "dependencies": {
    "@labkit/core-db": "workspace:*",
    "@labkit/core-domain": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tanstack/react-router": "^1.170.38",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.55.0",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^6.0.3",
    "vite": "^7.1.5"
  }
}
