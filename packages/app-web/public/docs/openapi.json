{
  "openapi": "3.1.0",
  "info": {
    "title": "LabKit graph API",
    "version": "1.0.0",
    "description": "Read-only HAL+JSON view of the LabKit research graph. Each resource embeds its neighbours under `_embedded`, keyed `relation:type` for outbound links and `type:relation` for inbound ones. `/collections` lists entities by type as Collection+JSON. Everything is scoped to a workspace: bare `/graph` and `/collections` are the default one, and `/workspace/{slug}` selects another, where an entity is addressed as `/workspace/{slug}/{handle}`."
  },
  "paths": {
    "/graph/{id}": {
      "get": {
        "summary": "One graph entity and its neighbours",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Entity handle, e.g. Q_1, LOE_1, CLM_27.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]+_[A-Za-z0-9]+$"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "How many hops of neighbours to embed. 0 returns the entity alone. Links in the response repeat the depth that was applied.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The entity, with its properties beside id and type.",
            "content": {
              "application/hal+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "The handle is malformed or not in the graph, or depth is out of range.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "The server is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "worktree": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/collections": {
      "get": {
        "summary": "One collection per node type",
        "responses": {
          "200": {
            "description": "A Collection+JSON document.",
            "content": {
              "application/vnd.collection+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/collections/{type}": {
      "get": {
        "summary": "The live nodes of one type: id, type and name",
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "A slug from /collections, e.g. question, claim, evidence-unit. `workspace` lists the workspaces (default workspace only).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A Collection+JSON document.",
            "content": {
              "application/vnd.collection+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Unknown type.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/workspace/{slug}/{name}": {
      "get": {
        "summary": "One collection or one entity, in a workspace",
        "description": "`limit` and `offset` apply to a collection, `depth` to an entity.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "A workspace slug from /collections/workspace.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Either a collection slug (lower case, e.g. `question`), which returns that collection, or an entity handle (e.g. `Q_1`), which returns that entity. A handle is upper case, so the two never clash.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "How many hops of neighbours to embed. 0 returns the entity alone. Links in the response repeat the depth that was applied.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A collection for a slug, an entity with its neighbours for a handle.",
            "content": {
              "application/vnd.collection+json": {
                "schema": {
                  "type": "object"
                }
              },
              "application/hal+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "The handle is malformed or not in the graph, or depth is out of range.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/workspace/{slug}/act": {
      "get": {
        "summary": "The workspace's acts, oldest first",
        "description": "Every write is recorded as an act: the command that was issued, and the changes it made. Each item links to what it affected: `subject`, and `touched` for the rest.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "A workspace slug from /collections/workspace.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Only acts after this position (`seq`). A `since` link on each page names the last act on it, so following it again asks for anything new.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A collection of acts (type `Command`).",
            "content": {
              "application/vnd.collection+json": {}
            }
          },
          "default": {
            "description": "The handle is malformed or not in the graph, or depth is out of range.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/workspace/{slug}/act/{seq}": {
      "get": {
        "summary": "One act",
        "description": "The command as issued (`command`) and every change it made (`changes`), shaped like the workspace's `domain_event` row. Its links run out to the entities it affected.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "A workspace slug from /collections/workspace.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seq",
            "in": "path",
            "required": true,
            "description": "An act's position in the workspace's record.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The act.",
            "content": {
              "application/hal+json": {}
            }
          },
          "default": {
            "description": "The handle is malformed or not in the graph, or depth is out of range.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/workspace/{slug}/{id}/events": {
      "get": {
        "summary": "What happened to one entity, change by change",
        "description": "A document, not a resource, so it has no `self`. It rolls up the changes that name the entity out of the acts that made them. Each embedded event has its act (`_links.parent`), its position in that act (`index`, from 1) and `dir`: `in`, `out` or `subject`. The same events are grouped as links `acts:about`, `edgeCreated:in` and `edgeCreated:out`. `limit` counts acts, not changes.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "A workspace slug from /collections/workspace.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Entity handle, e.g. Q_1, LOE_1, CLM_27.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]+_[A-Za-z0-9]+$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Only acts after this position (`seq`). A `since` link on each page names the last act on it, so following it again asks for anything new.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The entity's events.",
            "content": {
              "application/hal+json": {}
            }
          },
          "default": {
            "description": "The handle is malformed or not in the graph, or depth is out of range.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/workspace/{slug}": {
      "get": {
        "summary": "A workspace's collections: one per node type",
        "responses": {
          "200": {
            "description": "A Collection+JSON document.",
            "content": {
              "application/vnd.collection+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "A workspace slug from /collections/workspace.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
