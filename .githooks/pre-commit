#!/usr/bin/env bash
#
# Keep the dependency graphs honest: regenerate whenever a commit touches src/ or
# tests/, and stage them alongside.
#
# Two forms, two readers -- docs/dependency-graph.svg for a person in a browser,
# docs/dependency-graph.mmd for an agent reading text. One analysis renders both,
# so they cannot disagree.
#
# It regenerates on any src/ or tests/ change but stages only what actually
# moved, which is what makes "the graph changed" mean "the module structure
# changed". That holds because the output is byte-stable: two runs over an
# unchanged tree are identical, and an edit touching no import produces an
# identical graph. Both verified. So a comment-only commit costs ~1s and stages
# nothing, and correctness never rests on guessing which edits are structural --
# an import added inside an existing file moves the graph exactly as a new file
# does, and a heuristic gate would miss it.
#
# Enable with:  git config core.hooksPath .githooks
#
# Deliberately NOT a gate. `npx depcruise src tests --output-type err` is the
# gate; this only maintains documentation. So it never blocks a commit -- not
# when graphviz is missing, not when generation fails. A commit refused because
# a diagram would not render is a worse outcome than a stale diagram, and the
# staleness is announced rather than silent.
set -uo pipefail

root="$(git rev-parse --show-toplevel)" || exit 0
cd "$root" || exit 0

# Only when the thing the graph describes has actually changed. Staged paths
# only: a commit of docs alone should not rewrite a 135KB artefact.
if ! git diff --cached --name-only --diff-filter=ACMRD \
     | grep -Eq '^(src|tests)/'; then
  exit 0
fi

# The graph is generated from the working tree, not from the index, so a
# partial stage (`git add -p`, or unstaged edits sitting alongside) yields a
# diagram describing code this commit does not contain. Cheap to detect, not
# cheap to fix properly -- fixing it means checking the index out to a temp
# tree -- so it is reported rather than papered over.
if git diff --name-only --diff-filter=ACMRD | grep -Eq '^(src|tests)/'; then
  echo "pre-commit: unstaged changes under src/ or tests/ -- the dependency graphs" >&2
  echo "  will describe the working tree, not this commit." >&2
fi

if ! scripts/update-dependency-graph.sh; then
  echo "pre-commit: dependency graphs not updated; committing anyway." >&2
  exit 0
fi

# Only stage it if regeneration actually moved it.
staged=""
for graph in docs/dependency-graph.svg docs/dependency-graph.mmd; do
  [ -f "$graph" ] || continue
  if ! git diff --quiet -- "$graph"; then
    git add "$graph"
    staged="$staged $(basename "$graph")"
  fi
done
[ -n "$staged" ] && echo "pre-commit: staged$staged"

exit 0
