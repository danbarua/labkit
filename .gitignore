.DS_STORE
.DS_Store
node_modules
bin/
*.log
.env
.env.*
!.env.*.example

*.bun-build
.labkit

.idea

# Local dev tooling, not part of the checkout. Anything under .claude/ is
# assumed personal (MCP servers, hooks, permissions, machine-specific
# instructions) unless deliberately shared below.
.claude/*
!.claude/skills/
.mcp.json

# CodeGraph's SQLite index — a derived artefact rebuilt by `codegraph init`,
# and the reason for the .claude/ and .mcp.json entries above.
.codegraph/
