{
  // **This file is `.jsonc`, not `.json`, and that is load-bearing.** Biome's
  // JSON config rejects comments, and `biome format --write` then falls back to
  // its defaults **silently** -- no parse error, just "Formatted N files". It
  // re-indented 121 files to tabs at width 80 before anyone noticed. `biome
  // check` does report the parse error; the writing command does not.
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",

  // Every rule turned off below is off **by name, with a reason**, which is the
  // whole point: a blanket `"recommended": false` or a wall of `biome-ignore`
  // comments loses the difference between a finding this repo should act on and
  // a rule that disagrees with a deliberate choice.
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        // **Off because its fix breaks the build.** `tsconfig.json` runs
        // `noUncheckedIndexedAccess`, so `rows[0]` is `T | undefined` and
        // `rows[0]!` after a proven-non-empty check is the idiom the compiler
        // asks for — 148 of them. Running biome's own unsafe fix over those
        // produced `TS2322`s immediately: it strips the assertion the type
        // system requires. A rule whose autofix contradicts the typechecker is
        // not one this project can hold.
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // **Off for two sites, both in `src/db/backend.ts`**, casting through
        // `any` to reach `pglite-socket`'s untyped internals. That is the seam
        // where a third party's missing types stop being ours; `unknown` plus a
        // cast at every use is the same hole with more ceremony.
        "noExplicitAny": "off"
      }
    }
  },

  // Comments are re-indented and never reflowed — verified, not assumed:
  // formatting the whole repo changed 101 files and **zero** comment-text
  // lines, compared with leading whitespace stripped. That matters here more
  // than in most repos, because the comments are argued paragraphs and a
  // reflow would rewrite the arguments' line breaks.
  "files": {
    "includes": ["src/**", "tests/**", "scripts/**", "examples/**", "*.ts"],
    "ignoreUnknown": true
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Matches what the codebase was already hand-wrapped to.
    "lineWidth": 100
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },

  // Import order is a diff-churn machine and settles nothing. Left alone.
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
