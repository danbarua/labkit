{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  // `packages/app-web` is its own project with its own `tsconfig.json`, and it needs the
  // DOM lib and JSX that this one does not. Without this, `bun run typecheck`
  // compiles `packages/app-web/src/main.tsx` under the CLI's compiler options and reports
  // `Cannot find name 'document'` — a failure of where the file was read, not
  // of the file.
  "exclude": ["packages/app-web"]
}
