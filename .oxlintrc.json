{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    // `({ prompt: _, ...rest })` names `prompt` only to leave it out of `rest`. Setting any option
    // replaces all of oxlint's defaults, so the `_` patterns it would apply are repeated here.
    "no-unused-vars": [
      "warn",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ]
  }
}
