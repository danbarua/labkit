{
	"name": "labkit",
	"description": "LabKit is a toolkit for scientific research orchestration. It formalizes bureaucracy so agents focus on science.",
	"license": "MIT",
	"version": "0.0.1",
	"main": "src/index.ts",
	"type": "module",
	"bin": {
		"labkit": "src/cli/cli.ts"
	},
	"scripts": {
		"dev": "bun run src/cli/cli.ts",
		"mcp": "bun run src/cli/cli.ts mcp",
		"dev:install-hooks": "bash scripts/install-hooks.sh",
		"postinstall": "bash scripts/install-hooks.sh",
		"dev:dependency-cruiser": "bash scripts/update-dependency-graph.sh",
		"build": "bash scripts/build-binary.sh",
		"test": "bun test --timeout 20000",
		"spike:web": "bash scripts/compose.sh --profile spike up -d --build && bash scripts/compose.sh logs -f web",
		"explorer": "bun scripts/serve-explorer.ts",
		"spike:web:down": "bash scripts/compose.sh --profile spike down",
		"test:pg": "bash scripts/test-postgres.sh",
		"test:in-docker": "bash scripts/test-in-docker.sh",
		"typecheck": "tsc --noEmit",
		"check": "bun scripts/check-all.ts",
		"check:all-checks": "bun scripts/check-all-checks.ts",
		"check:format": "biome format .",
		"check:lint": "biome lint .",
		"format": "biome format --write .",
		"check:compositions": "bun scripts/check-compositions.ts",
		"check:doc-comments": "bun scripts/check-doc-comments.ts",
		"check:migrations": "bun scripts/check-migrations.ts",
		"check:no-tracked-symlinks": "bash scripts/check-no-tracked-symlinks.sh",
		"check:orm-unwrapped": "bun scripts/check-orm-unwrapped.ts",
		"check:facts": "bun scripts/check-facts.ts",
		"check:no-stringly-typed": "bun scripts/check-no-stringly-typed.ts",
		"check:prop-classes": "bun scripts/check-prop-classes.ts",
		"check:stdout": "bash scripts/check-stdout.sh",
		"check:tests-assert": "bun scripts/check-tests-assert.ts",
		"check:test-ceiling": "bun scripts/check-test-ceiling.ts",
		"check:test-teardown": "bun scripts/check-test-teardown.ts",
		"check:binary": "bash scripts/smoke-binary.sh",
		"check:cli": "bash scripts/smoke-cli.sh",
		"example": "bash examples/full-lifecycle.sh",
		"probe:dogfood": "bash scripts/probe-dogfood.sh",
		"db:generate": "drizzle-kit generate",
		"db:generate:custom": "drizzle-kit generate --custom",
		"board:status": "bash scripts/apply-board-status.sh",
		"ports": "bash scripts/worktree-ports.sh"
	},
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/bun": "latest",
		"@types/pg": "^8.21.0",
		"dependency-cruiser": "^18.2.0",
		"drizzle-kit": "^0.30.6"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"engines": {
		"bun": ">=1.3.10"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.7",
		"@electric-sql/pglite-age": "^0.0.8",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"commander": "^15.0.0",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.23.0",
		"picocolors": "^1.1.1",
		"zod": "^4.4.3"
	}
}
