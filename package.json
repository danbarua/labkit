{
	"name": "labkit",
	"description": "LabKit is a toolkit for scientific research orchestration. It formalizes bureaucracy so agents focus on science.",
	"license": "MIT",
	"version": "0.7.0",
	"main": "packages/core-domain/entry.ts",
	"type": "module",
	"bin": {
		"labkit": "packages/app-cli/cli.ts"
	},
	"scripts": {
		"acp:build": "bun build packages/app-acp/cli.ts packages/app-acp/examples/vscode-workspace.ts --target=bun --splitting --sourcemap=external --outdir=packages/app-acp/dist",
		"acp:debug": "bun run acp:build && LABKIT_ACP_TEST_BUILT=1 LABKIT_ACP_KEEP_TRACE=1 LOGTAPE_TEST_MODE=always LOGTAPE_TEST_LOWEST_LEVEL=debug bun test packages/app-acp/stdio.test.ts packages/app-acp/observability-flow.test.ts",
		"acp:dev": "bun packages/app-acp/cli.ts --config packages/app-acp/examples/vscode-workspace.ts",
		"acp:logs": "bun packages/app-acp/logs.ts",
		"acp:start": "bun packages/app-acp/dist/cli.js --config packages/app-acp/dist/examples/vscode-workspace.js",
		"bonsai:record": "zsh scripts/db/build-bonsai-record.sh",
		"e2e:agent": "bun packages/app-web/scripts/e2e-agent.ts",
		"scenarios:build": "bun scripts/build/build-scenario-docs.ts",
		"check:all-checks": "bun scripts/checks/check-all-checks.ts",
		"check:binary": "bash scripts/checks/smoke-binary.sh",
		"check:bunx-bun": "bun scripts/checks/check-bunx-bun.ts",
		"check:changed": "bun scripts/checks/check-changed.ts",
		"check:claude-md": "bun scripts/checks/check-claude-md.ts",
		"check:cli": "bash scripts/checks/smoke-cli.sh",
		"check:comment-length": "bun scripts/checks/check-comment-length.ts",
		"check:cypher-labels": "bun scripts/checks/check-cypher-labels.ts",
		"check:doc-comments": "bun scripts/checks/check-doc-comments.ts",
		"check:empty-population": "bun scripts/checks/check-empty-population.ts",
		"check:format": "biome format .",
		"check:help-groups": "bun scripts/checks/check-help-groups.ts",
		"check:lint": "biome lint .",
		"check:migrations": "bun scripts/checks/check-migrations.ts",
		"check:no-stringly-typed": "bun scripts/checks/check-no-stringly-typed.ts",
		"check:oxlint": "bunx --bun oxlint --type-aware packages scripts tests",
		"check:no-tracked-symlinks": "bash scripts/checks/check-no-tracked-symlinks.sh",
		"check:orm-unwrapped": "bun scripts/checks/check-orm-unwrapped.ts",
		"check:prop-classes": "bun scripts/checks/check-prop-classes.ts",
		"check:quick": "bun scripts/checks/check-quick.ts",
		"check:scenario-docs": "bun scripts/checks/check-scenario-docs.ts",
		"check:stdout": "bash scripts/checks/check-stdout.sh",
		"check:test-ceiling": "bun scripts/checks/check-test-ceiling.ts",
		"check:test-teardown": "bun scripts/checks/check-test-teardown.ts",
		"check:tests-assert": "bun scripts/checks/check-tests-assert.ts",
		"check": "bun scripts/checks/check-all.ts",
		"cli:build": "bash scripts/build/build-binary.sh",
		"cli:dev": "bun run packages/app-cli/cli.ts",
		"db:bootstrap": "bun scripts/db/bootstrap.ts",
		"db:generate:custom": "drizzle-kit generate --custom",
		"db:generate": "drizzle-kit generate",
		"format": "biome format --write .",
		"mcp:dev": "bun run packages/app-cli/cli.ts mcp",
		"ports": "bash scripts/dev/worktree-ports.sh",
		"postinstall": "bun scripts/dev/stamp-install.ts",
		"probe:dogfood": "zsh scripts/db/probe-dogfood.sh",
		"record:sync": "bun scripts/db/sync-record.ts",
		"snapshot:record": "bun scripts/db/snapshot-record.ts",
		"test:agent:logs": "LOGTAPE_TEST_MODE=always LOGTAPE_TEST_LOWEST_LEVEL=debug bun run test:agent",
		"test:agent": "bun test --timeout 20000 packages/core-agent packages/app-acp",
		"test:migration-safety": "bun scripts/db/test-migration-safety.ts",
		"test:pg": "bash scripts/checks/test-postgres.sh",
		"test": "bun test --timeout 20000",
		"typecheck": "bunx --bun tsc --noEmit",
		"vscode:build": "bun run --cwd packages/app-vscode build",
		"vscode:check-types": "bun scripts/checks/check-vscode-types.ts",
		"vscode:dev": "bun run vscode:build && code --extensionDevelopmentPath=$PWD/packages/app-vscode .",
		"web:build": "bun run --cwd packages/app-web build",
		"web:dev": "bun run --cwd packages/app-web dev",
		"web:check-types": "bun scripts/checks/check-web-types.ts"
	},
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@labkit/acp-transcripts": "workspace:*",
		"@labkit/app-acp": "workspace:*",
		"@labkit/app-cli": "workspace:*",
		"@labkit/app-mcp": "workspace:*",
		"@labkit/app-vscode": "workspace:*",
		"@labkit/core-db": "workspace:*",
		"@labkit/core-domain": "workspace:*",
		"@swc/core": "1.16.12",
		"@types/bun": "catalog:",
		"@types/pg": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"dependency-cruiser": "^18.2.0",
		"drizzle-kit": "catalog:",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "catalog:",
		"typescript-api": "npm:typescript@6.0.3",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"typescript": ">=5"
	},
	"engines": {
		"bun": ">=1.3.10"
	},
	"dependencies": {
		"@electric-sql/pglite": "catalog:",
		"@electric-sql/pglite-age": "catalog:",
		"@electric-sql/pglite-tools": "catalog:",
		"@modelcontextprotocol/sdk": "catalog:",
		"commander": "catalog:",
		"drizzle-orm": "catalog:",
		"pg": "catalog:",
		"picocolors": "catalog:",
		"zod": "catalog:"
	},
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@agentclientprotocol/sdk": "1.5.0",
			"@biomejs/biome": "^2.5.14",
			"@electric-sql/pglite": "^0.5.7",
			"@electric-sql/pglite-age": "^0.0.8",
			"@electric-sql/pglite-tools": "^0.4.8",
			"@logtape/logtape": "^2.3.7",
			"@logtape/testing-bun": "^2.3.7",
			"@modelcontextprotocol/sdk": "1.30.1",
			"@types/bun": "latest",
			"@types/pg": "^8.21.0",
			"@types/react": "^19.1.12",
			"@types/react-dom": "^19.1.9",
			"commander": "^15.0.0",
			"drizzle-kit": "^0.30.6",
			"drizzle-orm": "^0.45.2",
			"pg": "^8.23.0",
			"picocolors": "^1.1.1",
			"react": "^19.1.1",
			"react-dom": "^19.1.1",
			"typescript": "^7.0.2",
			"zod": "^4.6.5",
			"vite": "^7.1.5",
			"@vitejs/plugin-react": "^5.0.2",
			"effect": "4.0.0",
			"effective-acp": "0.4.0"
		}
	}
}
